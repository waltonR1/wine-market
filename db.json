  "goods_1": { "code": 0, "message": "ok", "data": { "id": 1, "name": "拉菲罗斯柴尔德古堡干红", "subtitle": "波尔多一级庄 2015", "price": 8888, "region": "波尔多", "type": "红葡萄酒", "alcohol": "13.5%", "image": "/assets/logo.png", "tag": "一级庄", "comment": 15, "description": "拉菲古堡（Chateau Lafite Rothschild）是享誉世界的波尔多五大一级名庄之一。2015年份表现卓越，单宁丝滑，带有精致的黑香醋、烟草及矿物质香气，陈年潜力巨大。" } },
  "goods_2": { "code": 0, "message": "ok", "data": { "id": 2, "name": "玛歌红亭干红葡萄酒", "subtitle": "玛歌庄园副牌", "price": 2580, "region": "波尔多", "type": "红葡萄酒", "alcohol": "13.5%", "image": "/assets/logo.png", "tag": "名庄", "comment": 8, "description": "玛歌红亭（Pavillon Rouge du Chateau Margaux）是顶级名庄玛歌庄园的副牌酒。它完美继承了玛歌庄园的高雅与细腻，口感柔美，充满红果与花香。" } },
  "goods_3": { "code": 0, "message": "ok", "data": { "id": 3, "name": "教皇新堡精品干红", "subtitle": "罗纳河谷核心产区", "price": 568, "region": "罗纳河谷", "type": "红葡萄酒", "alcohol": "14.5%", "image": "/assets/logo.png", "tag": "高分", "comment": 20, "description": "产自罗纳河谷教皇新堡（Chateauneuf du Pape）核心地块。混合了歌海娜、西拉等多种品种，香气浓郁，带有成熟红果、黑胡椒及地中海香料气息。" } },
  "goods_4": { "code": 0, "message": "ok", "data": { "id": 4, "name": "勃艮第夜丘村级干红", "subtitle": "经典黑皮诺口感", "price": 458, "region": "勃艮第", "type": "红葡萄酒", "alcohol": "13%", "image": "/assets/logo.png", "tag": "经典", "comment": 12, "description": "精选勃艮第夜丘（Cote de Nuits）优质地块黑皮诺。呈现迷人的宝石红色，带有樱桃、覆盆子等新鲜果香，单宁细腻，口感优雅且充满活力。" } },
  "goods_5": { "code": 0, "message": "ok", "data": { "id": 5, "name": "意大利巴罗洛红葡萄酒", "subtitle": "内比奥罗之王", "price": 680, "region": "皮埃蒙特", "type": "红葡萄酒", "alcohol": "14%", "image": "/assets/logo.png", "tag": "酒王", "comment": 5, "description": "巴罗洛（Barolo）被誉为“酒中之王”。采用100%内比奥罗葡萄酿造，具有标志性的玫瑰、干香草及松露香气，酒体雄厚，单宁强劲，具有极佳的陈年能力。" } },
  "goods_15": { "code": 0, "message": "ok", "data": { "id": 15, "name": "麦卡伦 12 年雪莉桶", "subtitle": "经典苏格兰威士忌", "price": 650, "region": "斯佩塞", "type": "单一麦芽威士忌", "alcohol": "40%", "image": "/assets/logo.png", "tag": "经典", "comment": 120, "description": "麦卡伦（Macallan）雪莉桶系列的代表作。在精选的西班牙雪莉橡木桶中陈酿至少12年，呈现深邃的金色，带有干果、生姜及甜香草的香气，余韵持久。" } },
  "goods_24": { "code": 0, "message": "ok", "data": { "id": 24, "name": "唐培里侬香槟王 2012", "subtitle": "年份香槟精品", "price": 1680, "region": "香槟区", "type": "起泡酒", "alcohol": "12.5%", "image": "/assets/logo.png", "tag": "顶级", "comment": 15, "description": "唐培里侬（Dom Perignon）仅在优秀的年份酿制年份香槟。2012年份口感饱满且精准，融合了花香、柑橘及烘烤面包的香气，气泡细腻，充满力量感。" } },
  "goods_6": { "code": 0, "message": "ok", "data": { "id": 6, "name": "尊享礼遇双支礼盒", "subtitle": "精选红酒两支装", "price": 398, "region": "多产区", "type": "礼盒", "alcohol": "13.5%", "image": "/assets/logo.png", "tag": "热销", "comment": 45, "description": "精选两款热销干红葡萄酒，配以高档礼盒包装，是您节日送礼、走亲访友的超值之选。" } },
  "goods_7": { "code": 0, "message": "ok", "data": { "id": 7, "name": "高端商务皮盒套装", "subtitle": "送礼体面过人", "price": 1280, "region": "法国", "type": "礼盒", "alcohol": "14%", "image": "/assets/logo.png", "tag": "奢华", "comment": 10, "description": "专为商务场景设计，采用进口皮质礼盒，内含两支精品波尔多干红及整套专业酒具，尽显尊贵身份。" } },
